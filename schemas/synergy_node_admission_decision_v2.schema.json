{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"synergy.node-admission-decision/v2",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","node_id","manifest_generation","manifest_body_digest","profile_digest","capability_registry_digest","build_lock_digest","evaluated_at","profile_status","build_readiness_status","admission_status","blockers","financial_authority","payment_authority","accounting_authority","execution_authority","deployment_authority","scientific_truth_authority","decision_digest"],
  "properties":{
    "schema":{"const":"synergy.node-admission-decision/v2"},
    "node_id":{"type":"string","minLength":1},
    "manifest_generation":{"type":"integer","minimum":1,"maximum":9007199254740991},
    "manifest_body_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "profile_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "capability_registry_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "build_lock_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "evaluated_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "profile_status":{"enum":["PROFILE_CONFORMANT","PROFILE_NONCONFORMANT"]},
    "build_readiness_status":{"enum":["BLOCKED_PROFILE","BLOCKED_BUILD_EVIDENCE"]},
    "admission_status":{"enum":["BLOCKED_PROFILE","BLOCKED_BUILD_EVIDENCE"]},
    "blockers":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "financial_authority":{"const":"NONE"},
    "payment_authority":{"const":"NONE"},
    "accounting_authority":{"const":"NONE"},
    "execution_authority":{"const":"NONE"},
    "deployment_authority":{"const":"NONE"},
    "scientific_truth_authority":{"const":"NONE"},
    "decision_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
